{
  "harness": "plan under conditions A, apply an update, recalculate, compare",
  "update": "traffic",
  "sampling": "uniform road points 2.0-12.0 km apart; t1 = next window >= 30 min later, same session",
  "scope": "Metro Manila, whole-city graph",
  "split": "test",
  "update_minutes": 30,
  "intersection": null,
  "lanes": 2,
  "event_age_minutes": 0.0,
  "event_active_minutes": 60.0,
  "systems": [
    "antroute",
    "baseline"
  ],
  "antroute_colony": {
    "n_ants": 8,
    "n_iterations": 15,
    "alpha": 1.0,
    "beta": 2.0,
    "evaporation": 0.5,
    "initial_pheromone": 1.0,
    "max_steps": null,
    "n_alternatives": 3,
    "seed": 0
  },
  "baseline_colony": {
    "n_ants": 8,
    "n_iterations": 15,
    "alpha": 1.0,
    "beta": 5.0,
    "rho": 0.3,
    "xi": 0.3,
    "q0": 0.7,
    "q": 1.0,
    "initial_pheromone": 1.0,
    "max_steps": null,
    "dead_end_recovery": true,
    "invert_eq9": false,
    "reset_on_replan": false,
    "seed": 0
  },
  "baseline_corridor_margin": 0.2,
  "response_time_definition": "seconds from conditions B being loaded (window risk and baseline observations cached) to the new route: applying the incidents plus the search; both systems on the same machine in one run",
  "shared_length_fraction_definition": "share of the old route's length the recalculated route still uses",
  "quality_definition": "congestion and event exposure of the old route under conditions B vs the recalculated route, both measured with ANTROUTE's risk tiers and Event-Aware layer at B; improvement = old - recalculated; route length descriptive",
  "warm_start": true,
  "machine": {
    "platform": "Windows-11-10.0.26200-SP0",
    "processor": "Intel64 Family 6 Model 141 Stepping 1, GenuineIntel",
    "cpu_count": 12,
    "python": "3.12.10"
  },
  "lambda": 2.0,
  "event_layer": {
    "enabled": true,
    "cost_term": "W = dist * (1 + lambda * Risk) * (1 + mu * Event)",
    "mu": 1.0,
    "strength": {
      "base_impact_by_lanes_occupied": {
        "1": 0.5,
        "2": 1.0,
        "3": 1.0
      },
      "edges_affected": "every edge touching the incident's intersection",
      "overlap": "strongest live incident, not the sum; Event in [0, 1]"
    },
    "decay": {
      "shape": "linear from the base impact at the report time to 0",
      "ttl_minutes": 60.0
    },
    "matching": "configs/event_landmarks.csv -> intersection; unmatched alerts are dropped"
  },
  "model": {
