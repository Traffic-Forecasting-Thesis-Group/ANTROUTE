    "n_ants": 8,
    "n_iterations": 15,
    "alpha": 1.0,
    "beta": 2.0,
    "evaporation": 0.5,
    "initial_pheromone": 1.0,
    "max_steps": null,
    "n_alternatives": 3,
    "seed": 0
  },
  "baseline_colony": {
    "n_ants": 8,
    "n_iterations": 15,
