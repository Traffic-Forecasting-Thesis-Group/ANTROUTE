{
  "metric": "Route Quality Before and After Condition Updates",
  "definition": "congestion exposure and event exposure of the old route (planned under the conditions at t0) under the new conditions at t1, vs the route recalculated under t1; route length descriptive. improvement = old - recalculated",
  "scope": "Metro Manila, whole-city graph",
  "split": "test",
  "update_minutes": 30,
  "require_events": false,
  "sampling": "uniform road points 2.0-12.0 km apart",
  "n_trips": 30,
  "n_route_changed": 0,
  "lambda": 2.0,
  "event_layer": {
    "enabled": true,
    "cost_term": "W = dist * (1 + lambda * Risk) * (1 + mu * Event)",
    "mu": 1.0,
    "strength": {
      "base_impact_by_lanes_occupied": {
        "1": 0.5,
        "2": 1.0,
        "3": 1.0
      },
      "edges_affected": "every edge touching the incident's intersection",
      "overlap": "strongest live incident, not the sum; Event in [0, 1]"
    },
    "decay": {
      "shape": "linear from the base impact at the report time to 0",
      "ttl_minutes": 60.0
    },
    "matching": "configs/event_landmarks.csv -> intersection; unmatched alerts are dropped"
  },
  "model": {
    "checkpoint": "/content/drive/MyDrive/MMDA_CHECKPOINTS/stgnn_edge_v8.pt",
    "use_text": true,
    "context": true,
    "context_drop": [],
    "flood_hazard": true
  },
