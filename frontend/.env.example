# Copy to .env.local and fill in. .env.local is gitignored, so each machine needs its own.

# FastAPI base URL. Leave unset to use http://127.0.0.1:8100 (docker-compose.override.yml
# remaps the backend's container port 8000 to 8100 on the host).
# Note: if you serve this app over HTTPS, this must be HTTPS too or the browser blocks
# every API call as mixed content.
VITE_API_URL=https://festival-hoping-stories-funky.trycloudflare.com

# Maps JavaScript API key. This is NOT the same restriction profile as the old native
# GOOGLE_MAPS_API_KEY: the web needs "Maps JavaScript API" enabled on the project, billing
# active, and an HTTP-referrer restriction that includes http://localhost:5173/*.
# Without it the map renders as a grey box with RefererNotAllowedMapError in the console.
VITE_GOOGLE_MAPS_API_KEY=

# Vector Map ID (Cloud Console -> Map Management). Required by AdvancedMarker and by the
# navigation camera's heading/tilt. Without it markers do not render.
VITE_GOOGLE_MAPS_MAP_ID=
